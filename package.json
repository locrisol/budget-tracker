{
  "name": "personal-budget-tracker",
  "version": "1.0.0",
  "description": "Solo-built personal budget / expense tracker using Express, Sequelize, Nunjucks, and SQLite.",
  "main": "src/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "start": "cross-env NODE_ENV=production node src/index.js",
    "seed": "node seed.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all"
  },
  "dependencies": {
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "nunjucks": "^3.2.4",
    "sequelize": "^6.32.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.1"
  }
}
