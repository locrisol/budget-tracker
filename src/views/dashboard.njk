{% extends "layout.njk" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
  <h1>Budget Dashboard</h1>
  <div class="row g-3">
    <div class="col-md-4">
      <div class="card">
        <h3>Total Income</h3>
        <p class="positive">€{{ totalIncome }}</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <h3>Total Expense</h3>
        <p class="negative">€{{ totalExpense }}</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <h3>Net</h3>
        <p>{{ net }}</p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Recent Transactions</h2>
    {% if recent.length == 0 %}
      <p>No transactions yet.</p>
    {% else %}
      <table>
        <thead>
          <tr>
            <th>Date</th><th>Type</th><th>Category</th><th>Amount</th><th>Description</th>
          </tr>
        </thead>
        <tbody>
          {% for t in recent %}
            <tr>
              <td>{{ t.date }}</td>
              <td>{{ t.type }}</td>
              <td>{{ t.Category.name }}</td>
              <td>{{ t.amount }}</td>
              <td>{{ t.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
    <p class="text-end mt-3">
      <a class="btn" href="/transactions">View all</a>
    </p>
  </div>

  <div class="card">
    <h2>By Category</h2>
    <canvas id="byCategoryChart" width="400" height="200"></canvas>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/scripts.js"></script>
  </div>
{% endblock %}
