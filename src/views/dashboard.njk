{% extends "layout.njk" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
  <h1>Budget Dashboard</h1>
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body">
          <h3 class="card-title">Total Income</h3>
          <p class="text-success fs-4">€{{ totalIncome }}</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body">
          <h3 class="card-title">Total Expense</h3>
          <p class="text-danger fs-4">€{{ totalExpense }}</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body">
          <h3 class="card-title">Net</h3>
          <p class="fs-4">{{ net }}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="card-title">Recent Transactions</h2>
      {% if recent.length == 0 %}
        <p class="mb-0">No transactions yet.</p>
      {% else %}
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Date</th><th>Type</th><th>Category</th><th>Amount</th><th>Description</th>
            </tr>
          </thead>
          <tbody>
            {% for t in recent %}
              <tr>
                <td>{{ t.date }}</td>
                <td>{{ t.type | capitalize }}</td>
                <td>{{ t.Category.name }}</td>
                <td>{{ t.amount }}</td>
                <td>{{ t.description }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
      <p class="text-end mt-3">
        <a class="btn btn-primary" href="/transactions">View all</a>
      </p>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h2 class="card-title">By Category</h2>
      <canvas id="byCategoryChart" width="400" height="200"></canvas>
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script src="/js/scripts.js"></script>
    </div>
  </div>
{% endblock %}
