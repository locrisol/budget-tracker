<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{% block title %}Budget Tracker{% endblock %}</title>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
  />
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
  <div class="container-fluid">
    <a class="navbar-brand border-end pe-3 me-3" href="/">Budget Tracker</a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNav"
      aria-controls="mainNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav nav-pills me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a
            class="nav-link {% if path=='/' %}active{% endif %}"
            href="/"
          >Dashboard</a>
        </li>
        <li class="nav-item">
          <a
            class="nav-link {% if path.startsWith('/transactions') and not path.endsWith('/new') %}active{% endif %}"
            href="/transactions"
          >Transactions</a>
        </li>
        <li class="nav-item">
          <a
            class="nav-link {% if path=='/transactions/new' %}active{% endif %}"
            href="/transactions/new"
          >Add Transaction</a>
        </li>
        <li class="nav-item">
          <a
            class="nav-link {% if path=='/categories' %}active{% endif %}"
            href="/categories"
          >Categories</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

  <main class="container py-4">
    {% if flash %}<div class="card">{{ flash }}</div>{% endif %}
    {% block content %}{% endblock %}
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
